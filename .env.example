# Copy to .env.local for development or set as environment variables in
# production. Never commit real values.

# Canonical public URL used for metadata, sitemap, robots, RSS, and JSON-LD.
# The default in src/config/site.ts reproduces the hostname exactly as it was
# supplied and has NOT been verified against DNS. Confirm the spelling and
# override it here before launch.
NEXT_PUBLIC_SITE_URL=https://KapilSahrma.mageiatech.com

# Contact form delivery (Resend). The form stays disabled and the /contact page
# shows direct links only until all three variables are set.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=you@yourdomain.example
# CONTACT_FROM_EMAIL=Portfolio <portfolio@yourdomain.example>

# Docker Compose host port (the container always listens on 3000).
HOST_PORT=3005
IMAGE_NAME=kapil-portfolio
IMAGE_TAG=latest
